{
  "root": true,
  "env": {
    "node": true,
    "jest": true
  },
  "extends": ["plugin:vue/vue3-recommended", "@vue/airbnb", "prettier"],
  "rules": {
    "no-param-reassign": [
      "error",
      {
        "props": true,
        "ignorePropertyModificationsFor": ["acc", "accumulator", "e", "el", "state"]
      }
    ],
    "import/prefer-default-export": 0
  },
  "parserOptions": {
    "parser": "@babel/eslint-parser",
    "requireConfigFile": false
  },
  "overrides": [
    {
      "files": ["**/__tests__/*.js"],
      "env": {
        "jest": true
      }
    }
  ]
}
